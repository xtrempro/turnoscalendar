rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasMfa() {
      return signedIn() &&
        request.auth.token.firebase != null &&
        "sign_in_second_factor" in request.auth.token.firebase &&
        request.auth.token.firebase.sign_in_second_factor != null;
    }

    function mfaRequirementActive() {
      // Produccion permanece desactivada. El build de reglas Test reemplaza
      // exclusivamente esta marca antes de publicar en ese proyecto.
      return false; // TURNOPLUS_TEST_MFA
    }

    function memberData(workspaceId) {
      return get(
        /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)
      ).data;
    }

    // Si el miembro puede editar ALGO en la unidad. Informaciones nace activo
    // si falta en permisos antiguos; Calificaciones solo hereda acceso cuando
    // el usuario ya tenia todos los menus anteriores con edicion.
    function memberCanEditSomething(workspaceId) {
      let member = memberData(workspaceId);
      let permissions =
        "permissions" in member ? member.permissions : {};

      return member.role == "owner" ||
        ("turnos" in permissions && permissions.turnos.edit == true) ||
        ("weekly" in permissions && permissions.weekly.edit == true) ||
        ("tasks" in permissions && permissions.tasks.edit == true) ||
        ("kanban" in permissions && permissions.kanban.edit == true) ||
        ("agenda" in permissions && permissions.agenda.edit == true) ||
        ("profile" in permissions && permissions.profile.edit == true) ||
        ("qualifications" in permissions && permissions.qualifications.edit == true) ||
        ("clockmarks" in permissions && permissions.clockmarks.edit == true) ||
        ("requests" in permissions && permissions.requests.edit == true) ||
        ("memos" in permissions && permissions.memos.edit == true) ||
        ("informations" in permissions && permissions.informations.edit == true) ||
        !("informations" in permissions) ||
        ("medicalEquipment" in permissions && permissions.medicalEquipment.edit == true) ||
        ("swap" in permissions && permissions.swap.edit == true) ||
        ("hours" in permissions && permissions.hours.edit == true) ||
        ("reports" in permissions && permissions.reports.edit == true) ||
        ("dashboard" in permissions && permissions.dashboard.edit == true) ||
        ("log" in permissions && permissions.log.edit == true);
    }

    function hasLegacyMenuGrant(permissions, menuKey) {
      return menuKey in permissions &&
        permissions[menuKey].view == true &&
        permissions[menuKey].edit == true;
    }

    function hasLegacyFullAdminPermissions(permissions) {
      return hasLegacyMenuGrant(permissions, "turnos") &&
        hasLegacyMenuGrant(permissions, "weekly") &&
        hasLegacyMenuGrant(permissions, "tasks") &&
        hasLegacyMenuGrant(permissions, "kanban") &&
        hasLegacyMenuGrant(permissions, "agenda") &&
        hasLegacyMenuGrant(permissions, "profile") &&
        hasLegacyMenuGrant(permissions, "clockmarks") &&
        hasLegacyMenuGrant(permissions, "requests") &&
        hasLegacyMenuGrant(permissions, "memos") &&
        hasLegacyMenuGrant(permissions, "swap") &&
        hasLegacyMenuGrant(permissions, "hours") &&
        hasLegacyMenuGrant(permissions, "reports") &&
        hasLegacyMenuGrant(permissions, "dashboard") &&
        hasLegacyMenuGrant(permissions, "log");
    }

    function qualificationsEnabledByDefault(permissions) {
      return !("qualifications" in permissions) &&
        hasLegacyFullAdminPermissions(permissions);
    }

    function medicalEquipmentEnabledByDefault(permissions) {
      return !("medicalEquipment" in permissions) &&
        hasLegacyFullAdminPermissions(permissions);
    }

    // El segundo factor se le exige exactamente a quien puede cambiar algo: a
    // quien solo mira no hay nada que protegerle.
    function memberRequiresMfa(workspaceId) {
      return memberCanEditSomething(workspaceId);
    }

    function memberHasExplicitAccess(workspaceId) {
      let member = memberData(workspaceId);

      return member.role == "owner" ||
        (
          member.role == "member" &&
          "permissions" in member &&
          member.permissions is map
        );
    }

    function isMember(workspaceId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) &&
        memberHasExplicitAccess(workspaceId) &&
        (
          !mfaRequirementActive() ||
          !memberRequiresMfa(workspaceId) ||
          hasMfa()
        );
    }

    function workspaceExists(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId));
    }

    function isOwner(workspaceId) {
      return isMember(workspaceId) &&
        memberData(workspaceId).role == "owner";
    }

    function isLinkedWorker(workspaceId, userId) {
      return signedIn() &&
        request.auth.uid == userId &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(userId));
    }

    function workerLinkExists(workspaceId, userId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(userId));
    }

    function isCurrentLinkedWorker(workspaceId) {
      return signedIn() &&
        workerLinkExists(workspaceId, request.auth.uid);
    }

    function canAccessWorkerPeerThread(workspaceId, threadId) {
      return isCurrentLinkedWorker(workspaceId) &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerPeerThreads/$(threadId)) &&
        request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)/workerPeerThreads/$(threadId)).data.participantUids;
    }

    function canReadWorkerPeerThread(workspaceId) {
      return isCurrentLinkedWorker(workspaceId) &&
        request.auth.uid in resource.data.participantUids;
    }

    function canAccessWorkerPeerThreadAfter(workspaceId, threadId) {
      return isCurrentLinkedWorker(workspaceId) &&
        existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/workerPeerThreads/$(threadId)) &&
        request.auth.uid in getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/workerPeerThreads/$(threadId)).data.participantUids;
    }

    function canManageProfiles(workspaceId) {
      let member =
        get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data;
      let permissions =
        "permissions" in member ? member.permissions : {};

      return isMember(workspaceId) &&
        (
          member.role == "owner" ||
          ("profile" in permissions && permissions.profile.edit == true)
        );
    }

    function canManageRequests(workspaceId) {
      let member =
        get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data;
      let permissions =
        "permissions" in member ? member.permissions : {};

      return isMember(workspaceId) &&
        (
          member.role == "owner" ||
          ("requests" in permissions && permissions.requests.edit == true) ||
          ("turnos" in permissions && permissions.turnos.edit == true)
        );
    }

    function canPublishWorkerData(workspaceId) {
      return canManageProfiles(workspaceId) ||
        canManageRequests(workspaceId);
    }

    function canReadWorkerData(workspaceId) {
      return isOwner(workspaceId) ||
        canViewMenu(workspaceId, "profile") ||
        canViewMenu(workspaceId, "turnos") ||
        canViewMenu(workspaceId, "requests") ||
        canViewMenu(workspaceId, "swap");
    }

    function canReadRequests(workspaceId) {
      return isOwner(workspaceId) ||
        canViewMenu(workspaceId, "requests") ||
        canViewMenu(workspaceId, "turnos") ||
        canViewMenu(workspaceId, "swap");
    }

    function canEditMenu(workspaceId, menuKey) {
      let member =
        get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data;
      let permissions =
        "permissions" in member ? member.permissions : {};

      return isMember(workspaceId) &&
        (
          member.role == "owner" ||
          (
            menuKey in permissions &&
            permissions[menuKey].edit == true
          ) ||
          (
            menuKey == "qualifications" &&
            qualificationsEnabledByDefault(permissions)
          ) ||
          (
            menuKey == "medicalEquipment" &&
            medicalEquipmentEnabledByDefault(permissions)
          )
        );
    }

    function canViewMenu(workspaceId, menuKey) {
      let member =
        get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data;
      let permissions =
        "permissions" in member ? member.permissions : {};

      return isMember(workspaceId) &&
        (
          member.role == "owner" ||
          (
            menuKey in permissions &&
            permissions[menuKey].view == true
          ) ||
          (
            menuKey == "qualifications" &&
            qualificationsEnabledByDefault(permissions)
          ) ||
          (
            menuKey == "medicalEquipment" &&
            medicalEquipmentEnabledByDefault(permissions)
          )
        );
    }

    function canViewInformationsMenu(workspaceId) {
      let member =
        get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data;
      let permissions =
        "permissions" in member ? member.permissions : {};

      return isMember(workspaceId) &&
        (
          member.role == "owner" ||
          (
            "informations" in permissions &&
            permissions.informations.view == true
          ) ||
          !("informations" in permissions)
        );
    }

    function canEditInformationsMenu(workspaceId) {
      let member =
        get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data;
      let permissions =
        "permissions" in member ? member.permissions : {};

      return isMember(workspaceId) &&
        (
          member.role == "owner" ||
          (
            "informations" in permissions &&
            permissions.informations.edit == true
          ) ||
          !("informations" in permissions)
        );
    }

    function canReadStateModule(workspaceId, moduleId) {
      return isOwner(workspaceId) ||
        (moduleId == "profile" && canViewMenu(workspaceId, "profile")) ||
        (moduleId == "qualifications" && canViewMenu(workspaceId, "qualifications")) ||
        (moduleId == "turnos" && canViewMenu(workspaceId, "turnos")) ||
        (moduleId == "clockmarks" && canViewMenu(workspaceId, "clockmarks")) ||
        (moduleId == "requests" && canViewMenu(workspaceId, "requests")) ||
        (moduleId == "memos" && canViewMenu(workspaceId, "memos")) ||
        (moduleId == "informations" && canViewInformationsMenu(workspaceId)) ||
        (moduleId == "medicalEquipment" && canViewMenu(workspaceId, "medicalEquipment")) ||
        (moduleId == "swap" && canViewMenu(workspaceId, "swap")) ||
        (moduleId == "hours" && canViewMenu(workspaceId, "hours")) ||
        (moduleId == "weekly" && canViewMenu(workspaceId, "weekly")) ||
        (moduleId == "tasks" && canViewMenu(workspaceId, "tasks")) ||
        (moduleId == "agenda" && canViewMenu(workspaceId, "agenda")) ||
        (moduleId == "reports" && canViewMenu(workspaceId, "reports")) ||
        (moduleId == "log" && canViewMenu(workspaceId, "log")) ||
        // El inicio no tiene permiso de menu propio: lo ve cualquier
        // administrador del entorno, y ahi viven las tareas diarias que uno
        // comparte con los demas.
        (moduleId == "home" && isMember(workspaceId));
    }

    function canWriteStateModule(workspaceId, moduleId) {
      return isOwner(workspaceId) ||
        (moduleId == "profile" && canEditMenu(workspaceId, "profile")) ||
        (moduleId == "qualifications" && canEditMenu(workspaceId, "qualifications")) ||
        (moduleId == "turnos" && canEditMenu(workspaceId, "turnos")) ||
        (moduleId == "clockmarks" && canEditMenu(workspaceId, "clockmarks")) ||
        (moduleId == "requests" && canEditMenu(workspaceId, "requests")) ||
        (moduleId == "memos" && canEditMenu(workspaceId, "memos")) ||
        (moduleId == "informations" && canEditInformationsMenu(workspaceId)) ||
        (moduleId == "medicalEquipment" && canEditMenu(workspaceId, "medicalEquipment")) ||
        (moduleId == "swap" && canEditMenu(workspaceId, "swap")) ||
        (moduleId == "hours" && canEditMenu(workspaceId, "hours")) ||
        (moduleId == "weekly" && canEditMenu(workspaceId, "weekly")) ||
        (moduleId == "tasks" && canEditMenu(workspaceId, "tasks")) ||
        (moduleId == "agenda" && canEditMenu(workspaceId, "agenda")) ||
        (moduleId == "reports" && canEditMenu(workspaceId, "reports")) ||
        (moduleId == "log" && canEditMenu(workspaceId, "log")) ||
        // El inicio se LEE con ser miembro (hay que ver lo que le compartieron
        // a uno), pero compartir es escribir en la unidad: un miembro de solo
        // lectura no lo hace. No hay menu propio que mirar, asi que se le pide
        // lo mismo que al segundo factor: poder editar algo.
        (
          moduleId == "home" &&
          isMember(workspaceId) &&
          memberCanEditSomething(workspaceId)
        );
    }

    function validText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function optionalText(data, key, maxLength) {
      return !(key in data) || validText(data[key], maxLength);
    }

    function validWorkerDirectoryWorker(worker) {
      return worker is map &&
        optionalText(worker, "name", 160) &&
        optionalText(worker, "role", 160) &&
        optionalText(worker, "profession", 160) &&
        worker.keys().hasOnly([
          "name",
          "role",
          "profession"
        ]);
    }

    function validOwnWorkerDirectoryPayload(workspaceId, userId) {
      return request.resource.data.uid == userId &&
        request.resource.data.workspaceId == workspaceId &&
        request.resource.data.status == "active" &&
        validText(request.resource.data.profileName, 160) &&
        optionalText(request.resource.data, "workspaceName", 160) &&
        optionalText(request.resource.data, "profession", 160) &&
        optionalText(request.resource.data, "role", 160) &&
        optionalText(request.resource.data, "updatedAtISO", 80) &&
        (!("updatedAt" in request.resource.data) ||
          request.resource.data.updatedAt is timestamp) &&
        (!("worker" in request.resource.data) ||
          validWorkerDirectoryWorker(request.resource.data.worker)) &&
        request.resource.data.keys().hasOnly([
          "uid",
          "workspaceId",
          "workspaceName",
          "profileName",
          "worker",
          "profession",
          "role",
          "status",
          "updatedAt",
          "updatedAtISO"
        ]);
    }

    function canWriteOwnWorkerMessageDirectory(workspaceId, userId) {
      return signedIn() &&
        request.auth.uid == userId &&
        isCurrentLinkedWorker(workspaceId) &&
        validOwnWorkerDirectoryPayload(workspaceId, userId);
    }

    function canDeleteOwnWorkerMessageDirectory(workspaceId, userId) {
      return signedIn() &&
        request.auth.uid == userId &&
        resource.data.uid == userId &&
        resource.data.workspaceId == workspaceId;
    }

    function canCreateOwnWorkspaceMember(workspaceId, userId) {
      return signedIn() &&
        userId == request.auth.uid &&
        workspaceExists(workspaceId) &&
        request.resource.data.role == "owner" &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUid == request.auth.uid &&
        (!mfaRequirementActive() || hasMfa());
    }

    function workerInviteNotExpired() {
      return !("expiresAt" in resource.data) ||
        resource.data.expiresAt > request.time;
    }

    function workerInviteCanBeOpened() {
      return resource.data.status == "pending";
    }

    function canReadWorkerInvite(inviteId) {
      return signedIn() &&
        resource.data.token == inviteId &&
        workerInviteCanBeOpened() &&
        workerInviteNotExpired();
    }

    function linkIdentityUnchanged() {
      return request.resource.data.fromWorkspaceId == resource.data.fromWorkspaceId &&
        request.resource.data.requestedByUid == resource.data.requestedByUid &&
        (
          request.resource.data.toWorkspaceId == resource.data.toWorkspaceId ||
          (
            resource.data.toWorkspaceId == "" &&
            request.resource.data.toOwnerUid == resource.data.toOwnerUid &&
            request.resource.data.toWorkspaceId is string
          )
        );
    }

    function canReadOwnerWorkspaceLink() {
      return signedIn() &&
        "toOwnerUid" in resource.data &&
        resource.data.toOwnerUid == request.auth.uid;
    }

    function hasLinkedTargetWorkspace() {
      return resource.data.toWorkspaceId is string &&
        resource.data.toWorkspaceId != "";
    }

    function canResolveOwnerWorkspaceLink() {
      return resource.data.toWorkspaceId == "" &&
        "toOwnerUid" in resource.data &&
        resource.data.toOwnerUid == request.auth.uid &&
        request.resource.data.toWorkspaceId is string &&
        request.resource.data.fromWorkspaceId != request.resource.data.toWorkspaceId &&
        workspaceExists(request.resource.data.toWorkspaceId) &&
        isOwner(request.resource.data.toWorkspaceId);
    }

    function canResolveWorkspaceLink() {
      return resource.data.status == "pending" &&
        (
          (
            hasLinkedTargetWorkspace() &&
            canManageRequests(resource.data.toWorkspaceId)
          ) ||
          canResolveOwnerWorkspaceLink()
        ) &&
        request.resource.data.status in ["accepted", "rejected"] &&
        optionalText(request.resource.data, "toWorkspaceName", 160) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "toWorkspaceId",
          "toWorkspaceName",
          "acceptedAt",
          "acceptedByUid",
          "acceptedByName",
          "rejectedAt",
          "rejectedByUid",
          "rejectedByName",
          "rejectReason",
          "updatedAt"
        ]);
    }

    function canUnlinkWorkspaceLink() {
      return resource.data.status == "accepted" &&
        request.resource.data.status == "unlinked" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "unlinkedAt",
          "unlinkedByUid",
          "unlinkedByName",
          "updatedAt"
        ]) &&
        (
          canManageRequests(resource.data.fromWorkspaceId) ||
          canManageRequests(resource.data.toWorkspaceId)
        );
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;

      match /workspaces/{workspaceId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /workerLinks/{workspaceId} {
        allow read, create, update: if signedIn() &&
          request.auth.uid == userId;
        allow delete: if signedIn() &&
          (
            request.auth.uid == userId ||
            canManageProfiles(workspaceId)
          );
      }
    }

    // Suscripcion/plan de la cuenta del dueño. Solo el dueño puede leer su
    // documento; la escritura es exclusiva del backend (Cloud Functions con
    // privilegios de admin), para que el plan no se pueda alterar desde el
    // cliente. El conteo de uso lo entrega la function getAccountUsage.
    match /accounts/{ownerUid} {
      allow read: if signedIn() && request.auth.uid == ownerUid;
      allow write: if false;
    }

    // Respaldo personal del trabajador anclado al RUT (recordatorios, agenda,
    // colores). Ningun cliente lo lee ni escribe directo: pasa por la Cloud
    // Function personalBackupSync, que verifica el vinculo uid<->RUT con el
    // Admin SDK. Asi el RUT no lo puede declarar el cliente para leer datos
    // ajenos.
    match /personalBackups/{rutKey} {
      allow read, write: if false;
    }

    // Alertas de recordatorio del trabajador (para el push programado). El
    // trabajador escribe sus recordatorios con alerta; el campo "sent" (control
    // de envios) lo escribe la Cloud Function con Admin SDK.
    match /reminderAlerts/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Registro de administradores globales. Los clientes no pueden leerlo ni
    // modificarlos; solo las Cloud Functions con Admin SDK lo consultan.
    match /adminUsers/{adminUid} {
      allow read, write: if false;
    }

    // Cupones: toda lectura/escritura pasa por Cloud Functions (admin SDK).
    // Crear/listar/desactivar es solo del admin; canjear escribe accounts via
    // la function redeemCoupon. El cliente nunca accede directo.
    match /coupons/{code} {
      allow read, write: if false;
    }

    // Config global (flag de gating, etc.): solo via Cloud Functions.
    match /config/{doc} {
      allow read, write: if false;
    }

    // Dashboards RRHH (enlace director↔unidades): solo via Cloud Functions con
    // Admin SDK. El cliente nunca lee/escribe; getRrhhDashboard resuelve el
    // alcance del viewer server-side.
    match /rrhhDashboards/{dashboardId} {
      allow read, write: if false;
    }

    // Pagos (Webpay/MercadoPago): solo via Cloud Functions (admin SDK). El
    // cliente nunca lee/escribe; recibe token/url por la function y vuelve por
    // el retorno publico.
    match /payments/{buyOrder} {
      allow read, write: if false;
    }

    match /workspaceLinks/{linkId} {
      allow create: if false;

      allow read: if canReadRequests(resource.data.fromWorkspaceId) ||
        (
          hasLinkedTargetWorkspace() &&
          canReadRequests(resource.data.toWorkspaceId)
        ) ||
        canReadOwnerWorkspaceLink();

      allow update: if linkIdentityUnchanged() &&
        (
          canResolveWorkspaceLink() ||
          canUnlinkWorkspaceLink()
        );

      allow delete: if false;
    }

    match /workerAppEmailInvites/{emailKey}/items/{inviteId} {
      // Un trabajador solo puede leer las invitaciones dirigidas a SU propio
      // correo (la clave del documento es el email normalizado en minusculas).
      // El supervisor no lee esta coleccion (solo escribe/borra), por lo que no
      // necesita acceso de lectura aqui. Antes era "if signedIn()", lo que
      // permitia a cualquier usuario enumerar invitaciones de cualquier correo.
      allow read: if signedIn() &&
        request.auth.token.email != null &&
        emailKey == request.auth.token.email.lower();
      allow create, update: if signedIn() &&
        request.resource.data.workspaceId is string &&
        validText(request.resource.data.email, 254) &&
        validText(request.resource.data.token, 160) &&
        request.resource.data.token == inviteId &&
        request.resource.data.emailKey == emailKey &&
        request.resource.data.email.lower() == emailKey &&
        request.resource.data.createdByUid == request.auth.uid &&
        optionalText(request.resource.data, "profileName", 160) &&
        optionalText(request.resource.data, "workspaceName", 160) &&
        canManageProfiles(request.resource.data.workspaceId);
      allow delete: if signedIn() &&
        resource.data.workspaceId is string &&
        canManageProfiles(resource.data.workspaceId);
    }

    match /workspaces/{workspaceId} {
      allow create: if signedIn() &&
        (!mfaRequirementActive() || hasMfa()) &&
        request.resource.data.ownerUid == request.auth.uid &&
        !("inviteCode" in request.resource.data) &&
        !("workersCount" in request.resource.data) &&
        !("activeWorkersCount" in request.resource.data) &&
        !("pwaUsersCount" in request.resource.data) &&
        !("countersUpdatedAt" in request.resource.data);
      allow get: if isMember(workspaceId);
      allow list: if false;
      allow update: if isOwner(workspaceId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "name",
            "updatedAt",
            "deletionStatus",
            "deletionRequestedAt",
            "deletionRequestedByUid",
            "deletionScheduledAt",
            "deletionCanceledAt"
          ]);
      allow delete: if isOwner(workspaceId);

      match /members/{userId} {
        allow get: if signedIn() &&
          (request.auth.uid == userId || isOwner(workspaceId));
        allow list: if isOwner(workspaceId);
        allow create: if canCreateOwnWorkspaceMember(workspaceId, userId);
        allow update, delete: if isOwner(workspaceId);
      }

      // Tablero Kanban privado por usuario (respaldo del tablero local). Solo el
      // propio usuario, miembro del entorno, lee/escribe su documento.
      match /kanbanBoards/{userId} {
        allow read, write: if isMember(workspaceId) &&
          request.auth.uid == userId;
      }

      match /supervisorInvites/{inviteId} {
        allow get: if isOwner(workspaceId) ||
          (
            signedIn() &&
            resource.data.claimedByUid == request.auth.uid
          );
        allow list: if isOwner(workspaceId);
        allow create, update, delete: if false;
      }

      match /system/appState {
        allow read, write: if false;
      }

      match /appStateChunks/{chunkId} {
        allow read, write: if false;
      }

      match /stateModules/{moduleId} {
        allow read: if canReadStateModule(workspaceId, moduleId);
        allow create, update: if
          canWriteStateModule(workspaceId, moduleId) &&
          request.resource.data.moduleId == moduleId &&
          request.resource.data.permission is string &&
          request.resource.data.chunkCount is int &&
          request.resource.data.chunkCount >= 1 &&
          request.resource.data.chunkCount <= 100 &&
          request.resource.data.charCount is int &&
          request.resource.data.charCount >= 0 &&
          request.resource.data.hash is string &&
          request.resource.data.hash.size() <= 160;
        allow delete: if canWriteStateModule(workspaceId, moduleId);

        match /chunks/{chunkId} {
          allow read: if canReadStateModule(workspaceId, moduleId);
          allow create, update: if
            canWriteStateModule(workspaceId, moduleId) &&
            request.resource.data.moduleId == moduleId &&
            request.resource.data.index is int &&
            request.resource.data.index >= 0 &&
            request.resource.data.index < 100 &&
            request.resource.data.text is string &&
            request.resource.data.text.size() <= 450000;
          allow delete: if canWriteStateModule(workspaceId, moduleId);
        }

        // Delta fino del estado: una edición de calendario escribe solamente
        // la clave/día modificado, sin republicar el módulo completo.
        match /entries/{entryId} {
          allow read: if canReadStateModule(workspaceId, moduleId);
          allow create, update: if
            canWriteStateModule(workspaceId, moduleId) &&
            request.resource.data.moduleId == moduleId &&
            request.resource.data.storageKey is string &&
            request.resource.data.storageKey.size() > 0 &&
            request.resource.data.storageKey.size() <= 260 &&
            (
              (
                "items" in request.resource.data &&
                request.resource.data.items is map &&
                "deletedItems" in request.resource.data &&
                request.resource.data.deletedItems is map
              ) ||
              (
                "deleted" in request.resource.data &&
                request.resource.data.deleted is bool &&
                (
                  request.resource.data.deleted == true ||
                  (
                    request.resource.data.value is string &&
                    request.resource.data.value.size() <= 900000
                  )
                )
              )
            );
          allow delete: if canWriteStateModule(workspaceId, moduleId);
        }
      }

      // Proyeccion operativa minima para prestamos. Una unidad enlazada solo
      // ve nombre, profesion, turnos y disponibilidad del mes; nunca accede al
      // snapshot completo, RUT, correo, documentos, permisos ni configuracion.
      match /linkedStaffingMonths/{monthId} {
        allow read: if canReadWorkerData(workspaceId);
        allow create, update: if
          canPublishWorkerData(workspaceId) &&
          request.resource.data.workspaceId == workspaceId &&
          request.resource.data.month == monthId &&
          request.resource.data.workers is list &&
          request.resource.data.workers.size() <= 500;
        allow delete: if canPublishWorkerData(workspaceId);
      }

      // Solo las Cloud Functions crean o anulan estos documentos. Los clientes
      // autenticados de cada unidad pueden leer su propia proyeccion.
      match /loanAssignments/{loanId} {
        allow read: if canReadRequests(workspaceId);
        allow write: if false;
      }

      match /system/localStorageSnapshot {
        allow read, write: if false;
      }

      match /profiles/{profileId} {
        allow read: if canReadWorkerData(workspaceId);
        allow write: if canManageProfiles(workspaceId);
      }

      match /replacementRequests/{requestId} {
        allow read: if canReadRequests(workspaceId) ||
          (signedIn() && resource.data.workerUid == request.auth.uid);
        allow create, delete: if canManageRequests(workspaceId);
        allow update: if canManageRequests(workspaceId) ||
          (
            signedIn() &&
            resource.data.workerUid == request.auth.uid &&
            request.resource.data.workerUid == resource.data.workerUid &&
            resource.data.status == "pending" &&
            request.resource.data.status in ["accepted", "rejected"] &&
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "status",
              "acceptedAt",
              "rejectedAt",
              "responseAt",
              "notificationStatus",
              "updatedAt"
            ])
          );
      }

      // Campañas de cobertura automatica. Solo las tocan quienes gestionan
      // solicitudes y la Cloud Function que hace avanzar las etapas (que usa el
      // SDK de administrador y no pasa por estas reglas). El trabajador no las
      // ve: lo que le llega es la solicitud de reemplazo.
      match /autoCoverageCampaigns/{campaignId} {
        allow read, write: if canManageRequests(workspaceId);
      }

      match /workerBlockedDays/{blockedDayId} {
        allow read: if canReadRequests(workspaceId) ||
          (signedIn() && resource.data.workerUid == request.auth.uid);
        allow create: if canManageRequests(workspaceId) ||
          (
            signedIn() &&
            request.resource.data.workerUid == request.auth.uid &&
            request.resource.data.workspaceId == workspaceId &&
            request.resource.data.source == "worker_app" &&
            request.resource.data.date is string &&
            blockedDayId == request.auth.uid + "_" + request.resource.data.date &&
            request.resource.data.status == "active" &&
            optionalText(request.resource.data, "reason", 500) &&
            optionalText(request.resource.data, "supervisorMessage", 2000) &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(request.auth.uid))
          );
        allow update: if canManageRequests(workspaceId) ||
          (
            signedIn() &&
            resource.data.workerUid == request.auth.uid &&
            request.resource.data.workerUid == request.auth.uid &&
            request.resource.data.workspaceId == workspaceId &&
            request.resource.data.source == "worker_app" &&
            request.resource.data.date is string &&
            blockedDayId == request.auth.uid + "_" + request.resource.data.date &&
            optionalText(request.resource.data, "reason", 500) &&
            optionalText(request.resource.data, "supervisorMessage", 2000) &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(request.auth.uid))
          );
        allow delete: if canManageRequests(workspaceId) ||
          (
            signedIn() &&
            resource.data.workerUid == request.auth.uid &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(request.auth.uid))
          );
      }

      match /workerRequests/{requestId} {
        allow read: if canReadRequests(workspaceId) ||
          (
            signedIn() &&
            (
              resource.data.createdByUid == request.auth.uid ||
              resource.data.targetUid == request.auth.uid
            ) &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(request.auth.uid))
          );
        allow create: if canManageRequests(workspaceId) ||
          (
            signedIn() &&
            request.resource.data.createdByUid == request.auth.uid &&
            request.resource.data.status in ["pending", "active"] &&
            request.resource.data.source == "worker_app" &&
            validText(request.resource.data.type, 60) &&
            optionalText(request.resource.data, "note", 2000) &&
            optionalText(request.resource.data, "detail", 2000) &&
            optionalText(request.resource.data, "rejectReason", 1000) &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(request.auth.uid))
          );
        allow update: if (
            canManageRequests(workspaceId) &&
            (
              resource.data.status != "canceled" ||
              request.resource.data.status == "canceled"
            )
          ) || (
            // El trabajador puede ANULAR (status -> "canceled") una solicitud
            // propia que siga pendiente, creada desde la app. No puede cambiar
            // el tipo, el autor ni tocar solicitudes ajenas o ya resueltas.
            signedIn() &&
            resource.data.createdByUid == request.auth.uid &&
            resource.data.source == "worker_app" &&
            resource.data.status == "pending" &&
            request.resource.data.status == "canceled" &&
            request.resource.data.createdByUid == resource.data.createdByUid &&
            request.resource.data.type == resource.data.type &&
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "status",
              "canceledAt",
              "canceledByUid",
              "cancelReason",
              "notificationStatus",
              "updatedAt"
            ]) &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(request.auth.uid))
          );
        allow delete: if canManageRequests(workspaceId);
      }

      match /medicalEquipmentReports/{reportId} {
        allow read: if canViewMenu(workspaceId, "medicalEquipment") ||
          (
            signedIn() &&
            resource.data.createdByUid == request.auth.uid &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(request.auth.uid))
          );
        allow create: if false;
        allow update, delete: if canEditMenu(workspaceId, "medicalEquipment");
      }

      match /workerSwapCandidates/{userId} {
        allow read: if canReadRequests(workspaceId) ||
          canPublishWorkerData(workspaceId) ||
          (
            signedIn() &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(request.auth.uid))
          );
        allow create, update, delete: if
          canPublishWorkerData(workspaceId);
      }

      match /workerMessageDirectory/{userId} {
        allow read: if canReadRequests(workspaceId) ||
          canPublishWorkerData(workspaceId) ||
          isCurrentLinkedWorker(workspaceId);
        allow create, update: if
          canPublishWorkerData(workspaceId) ||
          canWriteOwnWorkerMessageDirectory(workspaceId, userId);
        allow delete: if
          canPublishWorkerData(workspaceId) ||
          canDeleteOwnWorkerMessageDirectory(workspaceId, userId);
      }

      match /workerPeerThreads/{threadId} {
        allow read: if canReadWorkerPeerThread(workspaceId);
        allow create: if
          (
            isCurrentLinkedWorker(workspaceId) &&
            request.resource.data.workspaceId == workspaceId &&
            request.resource.data.createdByUid == request.auth.uid &&
            request.resource.data.targetUid is string &&
            request.resource.data.targetUid != request.auth.uid &&
            workerLinkExists(workspaceId, request.resource.data.targetUid) &&
            request.resource.data.participantUids is list &&
            request.resource.data.participantUids.size() == 2 &&
            request.auth.uid in request.resource.data.participantUids &&
            request.resource.data.targetUid in request.resource.data.participantUids
          );
        allow update: if
          (
            isCurrentLinkedWorker(workspaceId) &&
            request.auth.uid in resource.data.participantUids &&
            request.resource.data.workspaceId == resource.data.workspaceId &&
            request.resource.data.participantUids == resource.data.participantUids
          );
        allow delete: if isOwner(workspaceId);

        match /messages/{messageId} {
          allow read: if canAccessWorkerPeerThread(workspaceId, threadId);
          allow create: if
            (
              isCurrentLinkedWorker(workspaceId) &&
              canAccessWorkerPeerThreadAfter(workspaceId, threadId) &&
              request.resource.data.workspaceId == workspaceId &&
              request.resource.data.threadId == threadId &&
              request.resource.data.senderUid == request.auth.uid &&
              request.resource.data.targetUid is string &&
              request.resource.data.targetUid != request.auth.uid &&
              validText(request.resource.data.text, 2000) &&
              optionalText(request.resource.data, "senderName", 160) &&
              request.resource.data.targetUid in getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/workerPeerThreads/$(threadId)).data.participantUids &&
              workerLinkExists(workspaceId, request.resource.data.targetUid)
            );
          allow update, delete: if isOwner(workspaceId);
        }
      }

      match /workerSwapRequests/{requestId} {
        allow read: if canReadRequests(workspaceId) ||
          (
            signedIn() &&
            (
              resource.data.createdByUid == request.auth.uid ||
              resource.data.targetUid == request.auth.uid
            ) &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(request.auth.uid))
          );
        allow create: if canManageRequests(workspaceId);
        allow update: if
          (
            canManageRequests(workspaceId) &&
            (
              resource.data.status != "canceled" ||
              request.resource.data.status == "canceled"
            )
          );
        allow delete: if canManageRequests(workspaceId);
      }

      match /workerSwapOpenRequests/{openId} {
        allow read: if canReadRequests(workspaceId) ||
          (
            signedIn() &&
            resource.data.createdByUid == request.auth.uid &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(request.auth.uid))
          );
        allow create: if canManageRequests(workspaceId);
        allow update: if canManageRequests(workspaceId) &&
          (
            resource.data.status != "canceled" ||
            request.resource.data.status == "canceled"
          );
        allow delete: if canManageRequests(workspaceId);
      }

      match /workerAppInvites/{inviteId} {
        allow create: if isMember(workspaceId) &&
          request.resource.data.workspaceId == workspaceId &&
          request.resource.data.token == inviteId &&
          request.resource.data.status == "pending" &&
          validText(request.resource.data.email, 254) &&
          request.resource.data.createdByUid == request.auth.uid &&
          optionalText(request.resource.data, "profileName", 160) &&
          optionalText(request.resource.data, "workspaceName", 160) &&
          optionalText(request.resource.data, "inviteUrl", 2048) &&
          canManageProfiles(workspaceId);
        allow get: if canManageProfiles(workspaceId) ||
          canReadWorkerInvite(inviteId);
        allow list: if canManageProfiles(workspaceId);
        allow update: if canManageProfiles(workspaceId);
        allow delete: if canManageProfiles(workspaceId);
      }

      match /workerLinks/{userId} {
        allow read: if canReadWorkerData(workspaceId) ||
          (signedIn() && request.auth.uid == userId);
        allow create, update: if canManageProfiles(workspaceId) &&
          request.resource.data.uid == userId;
        allow delete: if canManageProfiles(workspaceId) ||
          (signedIn() && request.auth.uid == userId);
      }

      match /workerPushTokens/{userId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() &&
          request.auth.uid == userId &&
          exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(userId)) &&
          request.resource.data.uid == userId &&
          request.resource.data.workspaceId == workspaceId;
        allow delete: if canManageProfiles(workspaceId) ||
          (signedIn() && request.auth.uid == userId);

        match /tokens/{tokenId} {
          allow read: if signedIn() && request.auth.uid == userId;
          allow create, update: if signedIn() &&
            request.auth.uid == userId &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(userId)) &&
            request.resource.data.uid == userId &&
            request.resource.data.workspaceId == workspaceId &&
            request.resource.data.token is string &&
            request.resource.data.token.size() <= 4096 &&
            request.resource.data.active is bool;
          allow delete: if canManageProfiles(workspaceId) ||
            (signedIn() && request.auth.uid == userId);
        }
      }

      match /workerMessages/{userId} {
        allow read: if canManageRequests(workspaceId) ||
          (signedIn() && request.auth.uid == userId);
        allow create, update: if canManageRequests(workspaceId) ||
          (
            signedIn() &&
            request.auth.uid == userId &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(userId)) &&
            request.resource.data.uid == userId &&
            request.resource.data.workspaceId == workspaceId
          );
        allow delete: if canManageRequests(workspaceId);

        match /messages/{messageId} {
          allow read: if canManageRequests(workspaceId) ||
            (signedIn() && request.auth.uid == userId);
          allow create: if validText(request.resource.data.text, 2000) &&
            (
              canManageRequests(workspaceId) ||
              (
              signedIn() &&
              request.auth.uid == userId &&
              exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(userId)) &&
              request.resource.data.workerUid == userId &&
              request.resource.data.workspaceId == workspaceId &&
              validText(request.resource.data.text, 2000)
              )
            );
          allow update, delete: if canManageRequests(workspaceId);
        }
      }

      match /calendarEvents/{eventId} {
        allow read: if canManageProfiles(workspaceId);
        allow create: if canManageProfiles(workspaceId) &&
          request.resource.data.workspaceId == workspaceId &&
          request.resource.data.status == "pending" &&
          request.resource.data.affectedUserId is string &&
          request.resource.data.affectedUserId.size() <= 160 &&
          request.resource.data.createdByUid == request.auth.uid &&
          exists(/databases/$(database)/documents/workspaces/$(workspaceId)/workerLinks/$(request.resource.data.affectedUserId));
        allow update, delete: if false;
      }

      match /workerNotifications/{userId} {
        allow read: if canManageProfiles(workspaceId) ||
          isLinkedWorker(workspaceId, userId);
        allow create, update, delete: if false;

        match /items/{notificationId} {
          allow read: if canManageProfiles(workspaceId) ||
            isLinkedWorker(workspaceId, userId);
          allow create, delete: if false;
          allow update: if isLinkedWorker(workspaceId, userId) &&
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "isRead",
              "readAt"
            ]);
        }
      }

      // Programacion semanal publicada: es la MISMA para todo el workspace, asi
      // que vive en UN doc compartido (no duplicada por trabajador). La leen los
      // trabajadores enlazados y los miembros; la publica quien administra.
      match /published/{docId} {
        allow read: if isCurrentLinkedWorker(workspaceId) ||
          canReadWorkerData(workspaceId) ||
          (docId == "informations" && canViewInformationsMenu(workspaceId)) ||
          (docId == "medicalEquipment" && canViewMenu(workspaceId, "medicalEquipment"));
        allow write: if canPublishWorkerData(workspaceId) ||
          (docId == "informations" && canEditInformationsMenu(workspaceId)) ||
          (docId == "medicalEquipment" && canEditMenu(workspaceId, "medicalEquipment"));
      }

      // Confirmaciones de lectura de las informaciones: UN documento por
      // trabajador con el sello de cada una que confirmo
      // (`{ profileName, acks: { informacionId: fechaISO } }`).
      //
      // Lo escribe SOLO el trabajador dueno del documento, y unicamente esos
      // tres campos: la confirmacion es suya y nadie mas la firma por el, ni
      // siquiera el supervisor. El supervisor lee la coleccion entera para
      // armar el informe de quien leyo.
      match /informationReads/{userId} {
        allow get: if isLinkedWorker(workspaceId, userId) ||
          canViewInformationsMenu(workspaceId);
        allow list: if canViewInformationsMenu(workspaceId);
        allow create: if isLinkedWorker(workspaceId, userId) &&
          request.resource.data.keys().hasOnly([
            "profileName",
            "acks",
            "updatedAt"
          ]);
        // Una confirmacion SOLO se agrega. Borrar el documento esta prohibido
        // para que el informe no se pueda vaciar, y sin este `hasAll` el mismo
        // vaciado se lograba igual escribiendo `acks: {}` encima.
        allow update: if isLinkedWorker(workspaceId, userId) &&
          request.resource.data.keys().hasOnly([
            "profileName",
            "acks",
            "updatedAt"
          ]) &&
          request.resource.data.acks.keys().hasAll(resource.data.acks.keys());
        allow delete: if false;
      }

      match /workerAppData/{userId} {
        allow get: if canReadWorkerData(workspaceId) ||
          isLinkedWorker(workspaceId, userId);
        allow list: if canReadWorkerData(workspaceId);
        allow create: if
          canPublishWorkerData(workspaceId) ||
          (
            isLinkedWorker(workspaceId, userId) &&
            request.resource.data.keys().hasOnly([
              "blockedDayDates",
              "blockedDays",
              "blockedDaysUpdatedAt",
              "swapOptIn",
              "swapOptInUpdatedAt",
              "updatedAt"
            ])
          );
        allow update: if
          canPublishWorkerData(workspaceId) ||
          (
            isLinkedWorker(workspaceId, userId) &&
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "blockedDayDates",
              "blockedDays",
              "blockedDaysUpdatedAt",
              "swapOptIn",
              "swapOptInUpdatedAt",
              "updatedAt"
            ])
          );
        allow delete: if
          canPublishWorkerData(workspaceId);

        match /months/{monthId} {
          allow read: if canReadWorkerData(workspaceId) ||
            isLinkedWorker(workspaceId, userId);
          allow write: if
            canPublishWorkerData(workspaceId);
        }
      }

      // Marcador que deja el supervisor tras editar. La Cloud Function
      // buildWorkerAppProjection (Admin SDK) reconstruye el estado, computa la
      // proyeccion de cada trabajador y borra el marcador. Los clientes solo lo
      // crean; no lo leen ni lo borran.
      match /projectionRequests/{requestId} {
        allow create: if canPublishWorkerData(workspaceId) &&
          request.resource.data.profiles is list &&
          request.resource.data.profiles.size() <= 500;
        allow read, update, delete: if false;
      }

      // Resumen mensual RRHH publicado por la app para el Dashboard RRHH.
      // Lectura: cualquier miembro (la Cloud Function usa Admin SDK). Escritura:
      // miembros con permiso de ver dashboard/hours/turnos/reports (o el dueño).
      match /rrhhSummaries/{monthId} {
        allow read: if isMember(workspaceId);
        allow create, update: if isMember(workspaceId) &&
          (
            isOwner(workspaceId) ||
            canViewMenu(workspaceId, "dashboard") ||
            canViewMenu(workspaceId, "hours") ||
            canViewMenu(workspaceId, "turnos") ||
            canViewMenu(workspaceId, "reports")
          ) &&
          request.resource.data.month == monthId &&
          request.resource.data.source == "app" &&
          request.resource.data.hheeGastoClp is number &&
          request.resource.data.sinReemplazo is number;
        allow delete: if isOwner(workspaceId);
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
