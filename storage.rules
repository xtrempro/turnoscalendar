rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasMfa() {
      return signedIn() &&
        request.auth.token.firebase != null &&
        request.auth.token.firebase.sign_in_second_factor != null;
    }

    function mfaRequirementActive() {
      // Produccion permanece desactivada. El build de reglas Test reemplaza
      // exclusivamente esta marca antes de publicar en ese proyecto.
      return false; // TURNOPLUS_TEST_MFA
    }

    function member(workspaceId) {
      return firestore.get(
        /databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)
      ).data;
    }

    function workspace(workspaceId) {
      return firestore.get(
        /databases/(default)/documents/workspaces/$(workspaceId)
      ).data;
    }

    function isWorkspaceOwnerByDoc(workspaceId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId)) &&
        workspace(workspaceId).ownerUid == request.auth.uid;
    }

    function memberRequiresMfa(workspaceId) {
      let data = member(workspaceId);
      let permissions =
        "permissions" in data ? data.permissions : {};

      return data.role == "owner" ||
        ("turnos" in permissions && permissions.turnos.edit == true) ||
        ("weekly" in permissions && permissions.weekly.edit == true) ||
        ("tasks" in permissions && permissions.tasks.edit == true) ||
        ("kanban" in permissions && permissions.kanban.edit == true) ||
        ("agenda" in permissions && permissions.agenda.edit == true) ||
        ("profile" in permissions && permissions.profile.edit == true) ||
        ("qualifications" in permissions && permissions.qualifications.edit == true) ||
        ("requests" in permissions && permissions.requests.edit == true) ||
        ("memos" in permissions && permissions.memos.edit == true) ||
        ("informations" in permissions && permissions.informations.edit == true) ||
        !("informations" in permissions) ||
        ("medicalEquipment" in permissions && permissions.medicalEquipment.edit == true) ||
        ("tenders" in permissions && permissions.tenders.edit == true) ||
        ("swap" in permissions && permissions.swap.edit == true) ||
        ("hours" in permissions && permissions.hours.edit == true) ||
        ("reports" in permissions && permissions.reports.edit == true) ||
        ("dashboard" in permissions && permissions.dashboard.edit == true) ||
        ("log" in permissions && permissions.log.edit == true);
    }

    function hasLegacyMenuGrant(permissions, menuKey) {
      return menuKey in permissions &&
        permissions[menuKey].view == true &&
        permissions[menuKey].edit == true;
    }

    function hasLegacyFullAdminPermissions(permissions) {
      return hasLegacyMenuGrant(permissions, "turnos") &&
        hasLegacyMenuGrant(permissions, "weekly") &&
        hasLegacyMenuGrant(permissions, "tasks") &&
        hasLegacyMenuGrant(permissions, "kanban") &&
        hasLegacyMenuGrant(permissions, "agenda") &&
        hasLegacyMenuGrant(permissions, "profile") &&
        hasLegacyMenuGrant(permissions, "requests") &&
        hasLegacyMenuGrant(permissions, "memos") &&
        hasLegacyMenuGrant(permissions, "swap") &&
        hasLegacyMenuGrant(permissions, "hours") &&
        hasLegacyMenuGrant(permissions, "reports") &&
        hasLegacyMenuGrant(permissions, "dashboard") &&
        hasLegacyMenuGrant(permissions, "log");
    }

    function qualificationsEnabledByDefault(permissions) {
      return !("qualifications" in permissions) &&
        hasLegacyFullAdminPermissions(permissions);
    }

    function medicalEquipmentEnabledByDefault(permissions) {
      return !("medicalEquipment" in permissions) &&
        hasLegacyFullAdminPermissions(permissions);
    }

    function tendersEnabledByDefault(permissions) {
      return !("tenders" in permissions) &&
        hasLegacyFullAdminPermissions(permissions);
    }

    function memberHasExplicitAccess(workspaceId) {
      let data = member(workspaceId);

      return isWorkspaceOwnerByDoc(workspaceId) ||
        data.role == "owner" ||
        (
          data.role == "member" &&
          "permissions" in data &&
          data.permissions is map
        );
    }

    function isWorkspaceMember(workspaceId) {
      return signedIn() &&
        (
          isWorkspaceOwnerByDoc(workspaceId) ||
          (
            firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) &&
            memberHasExplicitAccess(workspaceId) &&
            (
              !mfaRequirementActive() ||
              !memberRequiresMfa(workspaceId) ||
              hasMfa()
            )
          )
        );
    }

    function isWorkspaceOwner(workspaceId) {
      return isWorkspaceOwnerByDoc(workspaceId) ||
        (
          isWorkspaceMember(workspaceId) &&
          member(workspaceId).role == "owner"
        );
    }

    function canViewModule(workspaceId, moduleId) {
      let permissions =
        "permissions" in member(workspaceId)
          ? member(workspaceId).permissions
          : {};

      return isWorkspaceOwner(workspaceId) ||
        (
          moduleId in permissions &&
          permissions[moduleId].view == true
        ) ||
        (
          moduleId == "medicalEquipment" &&
          medicalEquipmentEnabledByDefault(permissions)
        ) ||
        (
          moduleId == "tenders" &&
          tendersEnabledByDefault(permissions)
        );
    }

    function canEditModule(workspaceId, moduleId) {
      let permissions =
        "permissions" in member(workspaceId)
          ? member(workspaceId).permissions
          : {};

      return isWorkspaceOwner(workspaceId) ||
        (
          moduleId in permissions &&
          permissions[moduleId].edit == true
        ) ||
        (
          moduleId == "medicalEquipment" &&
          medicalEquipmentEnabledByDefault(permissions)
        ) ||
        (
          moduleId == "tenders" &&
          tendersEnabledByDefault(permissions)
        );
    }

    function canViewClockIncidentAttachment(workspaceId, moduleId) {
      return moduleId == "clockmarks" &&
        (
          canViewModule(workspaceId, "requests") ||
          canViewModule(workspaceId, "memos")
        );
    }

    function allowedFile() {
      // Solo imagenes raster (NO svg, que puede contener scripts), PDF, Office y
      // texto plano. Limite de 10 MB por archivo para reducir abuso y mantener los adjuntos
      // compatibles con el almacenamiento local/offline del navegador.
      return request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches(
          "image/(png|jpeg|jpg|pjpeg|gif|webp|bmp|heic|heif)|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet|text/plain|text/csv"
        );
    }

    function allowedScheduleImage() {
      return request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches(
          "image/(png|jpeg|jpg|pjpeg|gif|webp|bmp|heic|heif)"
        );
    }

    // Adjunto de un mensaje del supervisor a un trabajador. El ownerId es el uid
    // del trabajador destinatario: asi cada uno solo alcanza lo suyo.
    function isMessageAttachment(moduleId) {
      return moduleId == "messages";
    }

    // Respaldo de una licencia medica. No tiene permiso de menu propio: la
    // licencia se aplica desde el calendario, asi que quien puede editar Turnos
    // puede adjuntar su documento. Leerlo alcanza con ser miembro del entorno.
    function isLeaveAttachment(moduleId) {
      return moduleId == "leaves";
    }

    // La mensajeria no tiene permiso de menu propio (el boton flotante esta
    // disponible para todo miembro), asi que adjuntar sigue la misma regla:
    // basta con ser miembro del entorno.
    function allowedMessageFile() {
      return request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches(
          "image/(png|jpeg|jpg|pjpeg|gif|webp|bmp|heic|heif)|application/pdf"
        );
    }

    // El trabajador destinatario no es miembro del entorno: entra por su enlace
    // de PWA, y solo a los adjuntos dirigidos a el.
    function isLinkedWorkerRecipient(workspaceId, ownerId) {
      return signedIn() &&
        ownerId == request.auth.uid &&
        firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId)/workerLinks/$(request.auth.uid));
    }

    function isPublishedScheduleAttachment(moduleId, ownerId, recordId) {
      return moduleId == "tasks" &&
        ownerId == "weekly-schedule" &&
        recordId == "published-schedule";
    }

    function isPublishedInformationAttachment(moduleId, ownerId) {
      return moduleId == "informations" &&
        ownerId == "published";
    }

    function canViewInformationAttachment(workspaceId) {
      let data = member(workspaceId);
      let permissions =
        "permissions" in data ? data.permissions : {};

      return isWorkspaceMember(workspaceId) &&
        (
          isWorkspaceOwner(workspaceId) ||
          (
            "informations" in permissions &&
            permissions.informations.view == true
          ) ||
          !("informations" in permissions)
        );
    }

    function canPublishInformationAttachment(workspaceId) {
      let data = member(workspaceId);
      let permissions =
        "permissions" in data ? data.permissions : {};

      return isWorkspaceMember(workspaceId) &&
        (
          isWorkspaceOwner(workspaceId) ||
          (
            "informations" in permissions &&
            permissions.informations.edit == true
          ) ||
          !("informations" in permissions)
        );
    }

    function canPublishScheduleAttachment(workspaceId) {
      return signedIn() &&
        (
          isWorkspaceOwnerByDoc(workspaceId) ||
          (
            firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) &&
            memberHasExplicitAccess(workspaceId)
          )
        );
    }

    function canEditQualificationsAttachment(workspaceId) {
      let data = member(workspaceId);
      let permissions =
        "permissions" in data ? data.permissions : {};

      return isWorkspaceMember(workspaceId) &&
        (
          isWorkspaceOwnerByDoc(workspaceId) ||
          data.role == "owner" ||
          (
            "qualifications" in permissions &&
            permissions.qualifications.edit == true
          ) ||
          qualificationsEnabledByDefault(permissions)
        );
    }

    function canViewQualificationsAttachment(workspaceId) {
      let data = member(workspaceId);
      let permissions =
        "permissions" in data ? data.permissions : {};

      return isWorkspaceMember(workspaceId) &&
        (
          isWorkspaceOwnerByDoc(workspaceId) ||
          data.role == "owner" ||
          (
            "qualifications" in permissions &&
            permissions.qualifications.view == true
          ) ||
          qualificationsEnabledByDefault(permissions)
        );
    }

    function requestMetadataMatchesPath(workspaceId, moduleId, ownerId, recordId) {
      return request.resource.metadata.workspaceId == workspaceId &&
        request.resource.metadata.moduleId == moduleId &&
        request.resource.metadata.ownerId == ownerId &&
        request.resource.metadata.recordId == recordId &&
        request.resource.metadata.uploadedByUid == request.auth.uid;
    }

    match /workspaces/{workspaceId}/attachments/{moduleId}/{ownerId}/{recordId}/{fileName} {
      allow read: if isWorkspaceMember(workspaceId) &&
        (
          isMessageAttachment(moduleId) ||
          isLeaveAttachment(moduleId) ||
          (
            isPublishedInformationAttachment(moduleId, ownerId) &&
            canViewInformationAttachment(workspaceId)
          ) ||
          canViewModule(workspaceId, moduleId) ||
          canViewClockIncidentAttachment(workspaceId, moduleId) ||
          (moduleId == "qualifications" && canViewQualificationsAttachment(workspaceId)) ||
          resource.metadata.uploadedByUid == request.auth.uid
        ) ||
        (
          isPublishedScheduleAttachment(moduleId, ownerId, recordId) &&
          signedIn() &&
          firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId)/workerLinks/$(request.auth.uid))
        ) ||
        (
          isPublishedInformationAttachment(moduleId, ownerId) &&
          signedIn() &&
          firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId)/workerLinks/$(request.auth.uid))
        ) ||
        (
          isMessageAttachment(moduleId) &&
          isLinkedWorkerRecipient(workspaceId, ownerId)
        );

      allow create: if
        (
          (
            isPublishedScheduleAttachment(moduleId, ownerId, recordId) &&
            canPublishScheduleAttachment(workspaceId) &&
            allowedScheduleImage()
          ) ||
          (
            isPublishedInformationAttachment(moduleId, ownerId) &&
            canPublishInformationAttachment(workspaceId) &&
            allowedFile()
          ) ||
          (
            isMessageAttachment(moduleId) &&
            isWorkspaceMember(workspaceId) &&
            allowedMessageFile()
          ) ||
          (
            isLeaveAttachment(moduleId) &&
            isWorkspaceMember(workspaceId) &&
            canEditModule(workspaceId, "turnos") &&
            allowedMessageFile()
          ) ||
          (
            moduleId == "qualifications" &&
            canEditQualificationsAttachment(workspaceId) &&
            allowedFile()
          ) ||
          (
            moduleId != "tasks" &&
            !isMessageAttachment(moduleId) &&
            !isLeaveAttachment(moduleId) &&
            !isPublishedScheduleAttachment(moduleId, ownerId, recordId) &&
            !isPublishedInformationAttachment(moduleId, ownerId) &&
            isWorkspaceMember(workspaceId) &&
            canEditModule(workspaceId, moduleId) &&
            allowedFile()
          )
        ) &&
        (
          isPublishedScheduleAttachment(moduleId, ownerId, recordId) ||
          requestMetadataMatchesPath(workspaceId, moduleId, ownerId, recordId)
        );

      allow update: if
        isWorkspaceMember(workspaceId) &&
        (
          (
            isPublishedScheduleAttachment(moduleId, ownerId, recordId) &&
            (
              canPublishScheduleAttachment(workspaceId) ||
              resource.metadata.uploadedByUid == request.auth.uid
            ) &&
            allowedScheduleImage()
          ) ||
          (
            isMessageAttachment(moduleId) &&
            resource.metadata.uploadedByUid == request.auth.uid &&
            allowedMessageFile()
          ) ||
          (
            moduleId != "tasks" &&
            !isMessageAttachment(moduleId) &&
            !isPublishedScheduleAttachment(moduleId, ownerId, recordId) &&
            (
              canEditModule(workspaceId, moduleId) ||
              (moduleId == "qualifications" && canEditQualificationsAttachment(workspaceId)) ||
              resource.metadata.uploadedByUid == request.auth.uid
            ) &&
            allowedFile()
          )
        ) &&
        request.resource.metadata.workspaceId == resource.metadata.workspaceId &&
        request.resource.metadata.moduleId == resource.metadata.moduleId &&
        request.resource.metadata.ownerId == resource.metadata.ownerId &&
        request.resource.metadata.recordId == resource.metadata.recordId &&
        request.resource.metadata.uploadedByUid == resource.metadata.uploadedByUid;

      allow delete: if
        isWorkspaceMember(workspaceId) &&
        (
          (
            isPublishedScheduleAttachment(moduleId, ownerId, recordId) &&
            canPublishScheduleAttachment(workspaceId)
          ) ||
          (
            isLeaveAttachment(moduleId) &&
            canEditModule(workspaceId, "turnos")
          ) ||
          canEditModule(workspaceId, moduleId) ||
          (moduleId == "qualifications" && canEditQualificationsAttachment(workspaceId)) ||
          resource.metadata.uploadedByUid == request.auth.uid
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
